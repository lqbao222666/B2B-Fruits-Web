    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.2",
    "vue-easy-lightbox": "^1.19.0",
    "vue-router": "^5.0.3",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
