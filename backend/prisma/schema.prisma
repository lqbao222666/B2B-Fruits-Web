generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model VaiTro {
  role_id     Int     @id @default(autoincrement())
  ten_vai_tro String  @unique @db.VarChar(50)
  mo_ta       String?
  users       Users[]

  @@map("vai_tro")
}

model Users {
  user_id                Int               @id @default(autoincrement())
  email                  String?           @unique @db.VarChar(150)
  phone                  String            @unique @db.VarChar(15)
  password_hash          String            @db.VarChar(255)
  full_name              String            @db.VarChar(150)
  avatar_url             String?
  is_verified            Boolean           @default(false)
  is_active              Boolean           @default(true)
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  role_id                Int
  gioi_tinh              String?           @db.VarChar(10)
  ngay_sinh              DateTime?         @db.Date
  reset_password_expires DateTime?
  reset_password_otp     String?           @db.VarChar(10)
  aiEvents               AiEvents[]
  aiGoiYNhan             AiGoiY[]          @relation("nguoiNhan")
  baoCaoDua              BaoCao[]          @relation("nguoiBaoCao")
  baoCaoNhan             BaoCao[]          @relation("nguoiBiBC")
  danhGiaDua             DanhGia[]         @relation("nguoiDanhGia")
  danhGiaNhan            DanhGia[]         @relation("nguoiDuocDanhGia")
  diaChiLuus             DiaChiLuu[]
  doanhNghiep            DoanhNghiep?
  gioHangs               GioHang[]
  nongDan                NongDan?
  buyerSubscriptions     TheoDoiNguoiBan[] @relation("buyerSubscriptions")
  sellerSubscribers      TheoDoiNguoiBan[] @relation("sellerSubscribers")
  thongBaos              ThongBao[]
  tinNhanGui             TinNhan[]         @relation("nguoiGui")
  tinNhanNhan            TinNhan[]         @relation("nguoiNhan")
  vaiTro                 VaiTro            @relation(fields: [role_id], references: [role_id])

  @@map("users")
}

model NongDan {
  user_id                Int               @id
  ho_ten                 String            @db.VarChar(150)
  so_cmnd_cccd           String?           @unique @db.VarChar(20)
  tinh_thanh             String            @db.VarChar(100)
  huyen_xa               String?           @db.VarChar(100)
  dia_chi_cu_the         String?
  latitude               Decimal?          @db.Decimal(10, 8)
  longitude              Decimal?          @db.Decimal(11, 8)
  dien_tich_ha           Decimal?          @db.Decimal(8, 2)
  nong_san_chinh         String?           @db.VarChar(200)
  chung_nhan             String?           @db.VarChar(100)
  giay_phep_urls         Json?
  mo_ta_ban_than         String?
  diem_trung_binh        Decimal           @default(0) @db.Decimal(3, 2)
  tong_giao_dich         Int               @default(0)
  trang_thai             TrangThaiTaiKhoan @default(active)
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  email_lien_he          String?           @db.VarChar(150)
  /// Bổ sung từ form đăng ký
  so_dien_thoai          String            @unique @db.VarChar(15)
  doi_tuong_dang_ky      String?           @db.VarChar(100)
  /// Thông tin kinh doanh bổ sung
  ma_so_thue             String?           @unique @db.VarChar(20)
  ten_co_so_kd           String?           @db.VarChar(200)
  thong_tin_xuat_hoa_don Json?
  chu_tai_khoan          String?           @db.VarChar(150)
  ngan_hang              String?           @db.VarChar(100)
  /// Thông tin nhận tiền (Payout)
  phuong_thuc_nhan_tien  String?           @db.VarChar(50)
  so_tai_khoan           String?           @db.VarChar(50)
  baiDangs               BaiDang[]
  baoGiaDaGui            BaoGiaNhuCau[]
  donHangBan             DonHang[]         @relation("nguoiBan")
  user                   Users             @relation(fields: [user_id], references: [user_id])

  @@map("nong_dan")
}

model DoanhNghiep {
  user_id          Int                  @id
  ten_cong_ty      String               @db.VarChar(200)
  nganh_kinh_doanh String?              @db.VarChar(100)
  ma_so_thue       String?              @unique @db.VarChar(20)
  tinh_thanh       String               @db.VarChar(100)
  dia_chi          String?
  latitude         Decimal?             @db.Decimal(10, 8)
  longitude        Decimal?             @db.Decimal(11, 8)
  trang_thai       TrangThaiTaiKhoan    @default(active)
  created_at       DateTime             @default(now())
  updated_at       DateTime             @updatedAt
  diem_trung_binh  Decimal              @default(0) @db.Decimal(3, 2)
  giay_phep_kd_url String?
  mo_ta            String?
  tong_giao_dich   Int                  @default(0)
  website          String?              @db.VarChar(200)
  chuc_vu          String?              @db.VarChar(100)
  email_lien_he    String?              @db.VarChar(150)
  nguoi_dai_dien   String?              @db.VarChar(150)
  /// Bổ sung từ form đăng ký
  so_dien_thoai    String               @unique @db.VarChar(15)
  user             Users                @relation(fields: [user_id], references: [user_id])
  donHangMua       DonHang[]            @relation("nguoiMua")
  nhuCauThuMua     NhuCauThuMua[]
  thuongLuongList  ThuongLuongBaiDang[]

  @@map("doanh_nghiep")
}

model NhuCauThuMua {
  nhucau_id          Int             @id @default(autoincrement())
  /// Doanh nghiệp đăng nhu cầu
  doanh_nghiep_id    Int
  danhmuc_id         Int?
  ten_nong_san       String          @db.VarChar(200)
  mo_ta              String?
  so_luong_can       Decimal         @db.Decimal(10, 2)
  don_vi             String          @db.VarChar(20)
  /// Giá niêm yết tham khảo (có thể thương lượng)
  gia_tham_khao      Decimal?        @db.Decimal(12, 2)
  cho_thuong_luong   Boolean         @default(true)
  /// Yêu cầu chứng nhận (VietGAP, hữu cơ...)
  yeu_cau_chung_nhan String?         @db.VarChar(100)
  tinh_thanh_giao    String?         @db.VarChar(100)
  dia_chi_giao       String?
  /// Ngày bắt đầu và kết thúc thu mua
  ngay_bat_dau       DateTime?       @db.Date
  ngay_ket_thuc      DateTime?       @db.Date
  trang_thai         TrangThaiNhuCau @default(dang_thu_mua)
  luot_xem           Int             @default(0)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  /// Admin đã thông báo cho DN về hàng mới phù hợp chưa
  da_thong_bao       Boolean         @default(false)
  latitude           Decimal?        @db.Decimal(10, 8)
  longitude          Decimal?        @db.Decimal(11, 8)
  baoGiaList         BaoGiaNhuCau[]
  donHangs           DonHang[]
  danhGias           DanhGia[]
  danhMuc            DanhMuc?        @relation(fields: [danhmuc_id], references: [danhmuc_id])
  doanhNghiep        DoanhNghiep     @relation(fields: [doanh_nghiep_id], references: [user_id])

  @@index([trang_thai, ten_nong_san])
  @@index([doanh_nghiep_id])
  @@map("nhu_cau_thu_mua")
}

model BaoGiaNhuCau {
  baogia_id            Int             @id @default(autoincrement())
  nhucau_id            Int
  nong_dan_id          Int
  so_luong_cung_cap    Decimal         @db.Decimal(10, 2)
  don_vi               String          @db.VarChar(20)
  gia_de_xuat          Decimal         @db.Decimal(12, 2)
  chenh_lech_gia       Decimal         @default(0) @db.Decimal(12, 2)
  dia_chi_cung_cap     String?
  tinh_thanh_cung_cap  String?         @db.VarChar(100)
  latitude_cung_cap    Decimal?        @db.Decimal(10, 8)
  longitude_cung_cap   Decimal?        @db.Decimal(11, 8)
  khoang_cach_km       Decimal?        @db.Decimal(10, 2)
  phi_van_chuyen       Decimal?        @db.Decimal(15, 2)
  ghi_chu              String?
  lich_su_thuong_luong Json?
  trang_thai           TrangThaiBaoGia @default(cho_doanh_nghiep)
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  tieu_chuan_nong_dan  String?         @db.VarChar(100)
  nhuCau               NhuCauThuMua    @relation(fields: [nhucau_id], references: [nhucau_id], onDelete: Cascade)
  nongDan              NongDan         @relation(fields: [nong_dan_id], references: [user_id])

  @@index([nhucau_id])
  @@index([nong_dan_id])
  @@map("bao_gia_nhu_cau")
}

model ChungLoai {
  chungloai_id   Int       @id @default(autoincrement())
  ten_chung_loai String    @db.VarChar(100)
  slug           String    @unique @db.VarChar(100)
  mo_ta          String?
  icon_url       String?
  thu_tu         Int       @default(0)
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  danhMucs       DanhMuc[]

  @@map("chung_loai")
}

model DanhMuc {
  danhmuc_id   Int            @id @default(autoincrement())
  ten_danh_muc String         @db.VarChar(100)
  slug         String         @unique @db.VarChar(100)
  icon_url     String?
  thu_tu       Int            @default(0)
  is_active    Boolean        @default(true)
  mo_ta        String?
  chungloai_id Int?
  baiDangs     BaiDang[]
  chungLoai    ChungLoai?     @relation(fields: [chungloai_id], references: [chungloai_id])
  nhuCauThuMua NhuCauThuMua[]

  @@map("danh_muc")
}

model BaiDang {
  baidang_id            Int                  @id @default(autoincrement())
  /// Người đăng (Hồ sơ Nông Dân)
  nguoi_dang_id         Int
  danhmuc_id            Int
  tieu_de               String               @db.VarChar(200)
  mo_ta                 String
  ten_nong_san          String               @db.VarChar(150)
  don_vi_tinh           String               @db.VarChar(20)
  /// Số lượng ban đầu của lô hàng
  so_luong_co           Decimal              @db.Decimal(10, 2)
  so_luong_toi_thieu    Decimal              @default(1) @db.Decimal(10, 2)
  tinh_thanh            String               @db.VarChar(100)
  dia_chi_lay_hang      String?
  latitude              Decimal?             @db.Decimal(10, 8)
  longitude             Decimal?             @db.Decimal(11, 8)
  ngay_thu_hoach        DateTime?            @db.Date
  han_su_dung           DateTime?            @db.Date
  images                Json?
  is_seasonal           Boolean              @default(false)
  /// ── Trạng thái bài đăng ──
  /// cho_duyet: mới đăng, chờ thuật toán kiểm tra giá
  /// dang_ban: giá hợp lệ, hiển thị công khai
  /// da_ban: so_luong_con_lai = 0, tự động chuyển
  /// an: người đăng tự ẩn
  trang_thai            TrangThaiBaiDang     @default(cho_duyet)
  /// Admin từ chối / ẩn bài vì nội dung không hợp lệ
  ly_do_tu_choi         String?
  luot_xem              Int                  @default(0)
  diem_trung_binh       Decimal              @default(0) @db.Decimal(3, 2)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  /// Giá bán theo kg — do Nông Dân tự định, hệ thống kiểm tra bất thường
  gia_per_kg            Decimal              @db.Decimal(12, 2)
  /// Thời điểm thuật toán kiểm tra giá (NULL = chưa kiểm tra)
  checked_at            DateTime?
  /// Số lượng còn lại (hệ thống tự trừ sau mỗi đơn hàng hoàn thành)
  so_luong_con_lai      Decimal              @db.Decimal(10, 2)
  loai_cung_cap         LoaiCungCap          @default(lay_hang_ngay)
  ngay_bat_dau_cung_cap DateTime?            @db.Date
  aiEvents              AiEvents[]
  aiGoiYs               AiGoiY[]
  danhMuc               DanhMuc              @relation(fields: [danhmuc_id], references: [danhmuc_id])
  nguoiDang             NongDan              @relation(fields: [nguoi_dang_id], references: [user_id])
  danhGias              DanhGia[]
  donHangs              DonHang[]
  gioHangs              GioHang[]
  phanLoais             PhanLoaiSanPham[]
  thuongLuongList       ThuongLuongBaiDang[]
  tieuChuans            TieuChuan[]          @relation("BaiDangToTieuChuan")

  @@index([danhmuc_id, trang_thai])
  @@index([tinh_thanh, trang_thai])
  @@index([nguoi_dang_id])
  @@map("bai_dang")
}

model ThuongLuongBaiDang {
  thuongluong_id       Int                  @id @default(autoincrement())
  baidang_id           Int
  doanh_nghiep_id      Int
  don_vi               String               @db.VarChar(20)
  ghi_chu              String?
  lich_su_thuong_luong Json?
  hinh_thuc_giao_hang  HinhThucGiaoHang     @default(giao_tan_noi)
  dia_chi_giao         String?
  tinh_thanh_giao      String?              @db.VarChar(100)
  trang_thai           TrangThaiThuongLuong @default(cho_nong_dan)
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  donHangs             DonHang?
  baiDang              BaiDang              @relation(fields: [baidang_id], references: [baidang_id], onDelete: Cascade)
  doanhNghiep          DoanhNghiep          @relation(fields: [doanh_nghiep_id], references: [user_id])
  chiTiets             ThuongLuongChiTiet[]

  @@index([baidang_id])
  @@index([doanh_nghiep_id])
  @@map("thuong_luong_bai_dang")
}

model ThuongLuongChiTiet {
  id             Int                @id @default(autoincrement())
  thuongluong_id Int
  phanloai_id    Int
  so_luong_mua   Decimal            @db.Decimal(10, 2)
  gia_de_xuat    Decimal            @db.Decimal(12, 2)
  phanLoai       PhanLoaiSanPham    @relation(fields: [phanloai_id], references: [phanloai_id], onDelete: Cascade)
  thuongLuong    ThuongLuongBaiDang @relation(fields: [thuongluong_id], references: [thuongluong_id], onDelete: Cascade)

  @@map("thuong_luong_chi_tiet")
}

model PhanLoaiSanPham {
  phanloai_id         Int                  @id @default(autoincrement())
  baidang_id          Int
  ten_phan_loai       String               @db.VarChar(100)
  gia                 Decimal              @db.Decimal(12, 2)
  so_luong_co         Decimal              @db.Decimal(10, 2)
  so_luong_con_lai    Decimal              @db.Decimal(10, 2)
  donHangChiTiets     DonHangChiTiet[]
  gioHangs            GioHang[]
  baiDang             BaiDang              @relation(fields: [baidang_id], references: [baidang_id], onDelete: Cascade)
  thuongLuongChiTiets ThuongLuongChiTiet[]

  @@map("phan_loai_san_pham")
}

model TieuChuan {
  tieuchuan_id   Int       @id @default(autoincrement())
  ten_tieu_chuan String    @unique @db.VarChar(100)
  mo_ta          String?
  icon_url       String?
  created_at     DateTime  @default(now())
  baiDangs       BaiDang[] @relation("BaiDangToTieuChuan")

  @@map("tieu_chuan")
}

model GioHang {
  id          Int             @id @default(autoincrement())
  user_id     Int
  baidang_id  Int
  phanloai_id Int
  so_luong    Decimal         @db.Decimal(10, 2)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt
  baiDang     BaiDang         @relation(fields: [baidang_id], references: [baidang_id], onDelete: Cascade)
  phanLoai    PhanLoaiSanPham @relation(fields: [phanloai_id], references: [phanloai_id], onDelete: Cascade)
  user        Users           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@map("gio_hang")
}

model DonHang {
  donhang_id               Int                  @id @default(autoincrement())
  ma_don_hang              String               @unique @db.VarChar(50)
  phuong_thuc_tt           PhuongThucThanhToan?
  trang_thai_tt            TrangThaiThanhToan   @default(chua_thanh_toan)
  /// Địa chỉ giao hàng
  dia_chi_giao             String
  tinh_thanh_giao          String               @db.VarChar(100)
  ghi_chu                  String?
  trang_thai_don           TrangThaiDonHang     @default(cho_xac_nhan)
  ngay_tao                 DateTime             @default(now())
  ngay_xac_nhan            DateTime?
  ngay_hoan_thanh          DateTime?
  updated_at               DateTime             @updatedAt
  baidang_id               Int?
  /// Lý do huỷ (nếu bị huỷ)
  ly_do_huy                String?
  ngay_giao_du_kien        DateTime?
  /// Người bán (Hồ sơ Nông Dân)
  nguoi_ban_id             Int
  /// Người mua (Hồ sơ Doanh nghiệp)
  nguoi_mua_id             Int
  /// Tổng tiền = SUM(so_luong × don_gia của DonHangChiTiet)
  tong_tien                Decimal              @db.Decimal(15, 2)
  /// Thông tin vận chuyển mới
  hinh_thuc_giao_hang      HinhThucGiaoHang     @default(giao_tan_noi)
  khoang_cach              Decimal?             @db.Decimal(10, 2)
  ma_xac_nhan              String?              @db.VarChar(50)
  phi_van_chuyen           Decimal?             @db.Decimal(15, 2)
  tien_coc                 Decimal?             @db.Decimal(15, 2)
  doanh_nghiep_da_tt_coc   Boolean              @default(false)
  nong_dan_da_tt_vanchuyen Boolean              @default(false)
  nong_dan_xac_nhan_giao   Boolean              @default(false)
  ngay_nong_dan_xac_nhan   DateTime?
  nhucau_id                Int?
  thuongluong_id           Int?                 @unique
  baoCaos                  BaoCao[]
  danhGia                  DanhGia?
  baiDang                  BaiDang?             @relation(fields: [baidang_id], references: [baidang_id], onDelete: Cascade)
  nguoiBan                 NongDan              @relation("nguoiBan", fields: [nguoi_ban_id], references: [user_id])
  nguoiMua                 DoanhNghiep          @relation("nguoiMua", fields: [nguoi_mua_id], references: [user_id])
  nhuCau                   NhuCauThuMua?        @relation(fields: [nhucau_id], references: [nhucau_id], onDelete: Cascade)
  thuongLuong              ThuongLuongBaiDang?  @relation(fields: [thuongluong_id], references: [thuongluong_id])
  chiTiets                 DonHangChiTiet[]
  thanhToan                ThanhToan?
  tinNhans                 TinNhan[]

  @@index([nguoi_mua_id, trang_thai_don])
  @@index([nguoi_ban_id, trang_thai_don])
  @@map("don_hang")
}

model DonHangChiTiet {
  id           Int              @id @default(autoincrement())
  donhang_id   Int
  phanloai_id  Int?
  so_luong     Decimal          @db.Decimal(10, 2)
  don_gia      Decimal          @db.Decimal(12, 2)
  thanh_tien   Decimal          @db.Decimal(15, 2)
  ten_san_pham String?          @db.VarChar(200)
  donHang      DonHang          @relation(fields: [donhang_id], references: [donhang_id], onDelete: Cascade)
  phanLoai     PhanLoaiSanPham? @relation(fields: [phanloai_id], references: [phanloai_id], onDelete: Cascade)

  @@map("don_hang_chi_tiet")
}

model ThanhToan {
  thanhtoan_id Int                 @id @default(autoincrement())
  donhang_id   Int                 @unique
  so_tien      Decimal             @db.Decimal(15, 2)
  phuong_thuc  PhuongThucThanhToan
  /// Mã giao dịch từ cổng thanh toán
  ma_gd_cong   String?             @unique @db.VarChar(100)
  trang_thai   TrangThaiThanhToan  @default(chua_thanh_toan)
  thoi_gian_tt DateTime?
  /// Payload webhook từ VNPAY / MoMo
  metadata     Json?
  created_at   DateTime            @default(now())
  donHang      DonHang             @relation(fields: [donhang_id], references: [donhang_id], onDelete: Cascade)

  @@map("thanh_toan")
}

model DanhGia {
  danhgia_id       Int            @id @default(autoincrement())
  donhang_id       Int            @unique
  /// Điểm chất lượng sản phẩm (1-5)
  diem_chat_luong  Int?           @db.SmallInt
  nhan_xet         String?
  images           Json?
  created_at       DateTime       @default(now())
  baidang_id       Int?
  nhucau_id        Int?
  /// Điểm đúng hẹn giao hàng (1-5)
  diem_dung_hen    Int?           @db.SmallInt
  /// Điểm thái độ / giao tiếp (1-5)
  diem_thai_do     Int?           @db.SmallInt
  /// Điểm tổng thể (1-5)
  diem_tong        Int            @db.SmallInt
  /// Người để lại đánh giá
  nguoi_danhgia_id Int
  /// Người được đánh giá
  nguoi_duoc_dg_id Int
  /// Người được đánh giá có thể trả lời
  tra_loi          String?
  baiDang          BaiDang?       @relation(fields: [baidang_id], references: [baidang_id], onDelete: Cascade)
  nhuCau           NhuCauThuMua?  @relation(fields: [nhucau_id], references: [nhucau_id], onDelete: Cascade)
  donHang          DonHang        @relation(fields: [donhang_id], references: [donhang_id], onDelete: Cascade)
  nguoiDanhGia     Users          @relation("nguoiDanhGia", fields: [nguoi_danhgia_id], references: [user_id])
  nguoiDuocDanhGia Users          @relation("nguoiDuocDanhGia", fields: [nguoi_duoc_dg_id], references: [user_id])

  @@map("danh_gia")
}

model TinNhan {
  tinnhan_id    Int      @id @default(autoincrement())
  nguoi_gui_id  Int
  nguoi_nhan_id Int
  /// Tin nhắn thuộc đơn hàng nào (nếu có)
  donhang_id    Int?
  noi_dung      String
  attachments   Json?
  da_doc        Boolean  @default(false)
  thoi_gian     DateTime @default(now())
  donHang       DonHang? @relation(fields: [donhang_id], references: [donhang_id], onDelete: Cascade)
  nguoiGui      Users    @relation("nguoiGui", fields: [nguoi_gui_id], references: [user_id])
  nguoiNhan     Users    @relation("nguoiNhan", fields: [nguoi_nhan_id], references: [user_id])

  @@index([nguoi_gui_id, nguoi_nhan_id])
  @@map("tin_nhan")
}

model ThongBao {
  tb_id         Int          @id @default(autoincrement())
  user_id       Int
  loai          LoaiThongBao
  tieu_de       String       @db.VarChar(200)
  noi_dung      String
  /// ID tham chiếu tuỳ loại (donhang_id, baidang_id, nhucau_id...)
  ref_id        Int?
  ref_type      String?      @db.VarChar(50)
  kenh          KenhThongBao @default(app)
  da_doc        Boolean      @default(false)
  thoi_gian_gui DateTime     @default(now())
  user          Users        @relation(fields: [user_id], references: [user_id])

  @@index([user_id, da_doc])
  @@map("thong_bao")
}

model BaoCao {
  baocao_id         Int             @id @default(autoincrement())
  /// Người gửi báo cáo (Nông Dân)
  nguoi_baocao_id   Int
  /// Người bị báo cáo / Doanh nghiệp liên quan
  nguoi_bi_bc_id    Int?
  /// Bài đăng liên quan
  baidang_id        Int?
  loai              LoaiBaoCao
  mo_ta             String
  bang_chung        Json?
  trang_thai        TrangThaiBaoCao @default(cho_xu_ly)
  /// Admin xử lý
  xu_ly_boi         Int?
  ghi_chu_xu_ly     String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  /// Đơn hàng liên quan (bắt buộc đối với báo cáo trước khi giao)
  donhang_id        Int?
  de_xuat           DeXuatBaoCao    @default(gia_han)
  ngay_giao_de_xuat DateTime?
  donHang           DonHang?        @relation(fields: [donhang_id], references: [donhang_id])
  nguoiBaoCao       Users           @relation("nguoiBaoCao", fields: [nguoi_baocao_id], references: [user_id])
  nguoiBiBaoCao     Users?          @relation("nguoiBiBC", fields: [nguoi_bi_bc_id], references: [user_id])

  @@map("bao_cao")
}

model AiEvents {
  event_id      BigInt     @id @default(autoincrement())
  user_id       Int
  loai_sk       LoaiSuKien
  session_id    String?    @db.VarChar(100)
  /// Thời gian xem (giây)
  thoi_gian_xem Int?
  /// Metadata: từ khoá tìm kiếm, filter đã dùng...
  metadata      Json?
  thoi_gian     DateTime   @default(now())
  /// Bài đăng liên quan (nếu có)
  baidang_id    Int?
  baiDang       BaiDang?   @relation(fields: [baidang_id], references: [baidang_id], onDelete: Cascade)
  user          Users      @relation(fields: [user_id], references: [user_id])

  @@index([user_id, thoi_gian])
  @@index([baidang_id, loai_sk])
  @@map("ai_events")
}

model AiGoiY {
  goiy_id         Int      @id @default(autoincrement())
  loai_goiy       LoaiGoiY
  /// Điểm phù hợp [0.0000 – 1.0000]
  diem_phu_hop    Decimal  @db.Decimal(6, 4)
  da_click        Boolean  @default(false)
  phien_ban_model String?  @db.VarChar(30)
  thoi_gian_tao   DateTime @default(now())
  /// Bài đăng được gợi ý (nếu loại = sản phẩm)
  baidang_id      Int?
  da_giao_dich    Boolean  @default(false)
  /// Người dùng được gợi ý làm đối tác (nếu loại = đối tác)
  doi_tac_id      Int?
  /// Lý do gợi ý (giải thích của AI)
  ly_do_goi_y     String?
  /// Người nhận gợi ý
  nguoi_nhan_id   Int
  baiDang         BaiDang? @relation(fields: [baidang_id], references: [baidang_id], onDelete: Cascade)
  nguoiNhan       Users    @relation("nguoiNhan", fields: [nguoi_nhan_id], references: [user_id])

  @@index([nguoi_nhan_id, loai_goiy, thoi_gian_tao])
  @@map("ai_goi_y")
}

model DiaChiLuu {
  id         Int      @id @default(autoincrement())
  user_id    Int
  ten_goi    String   @db.VarChar(100)
  dia_chi    String?
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  created_at DateTime @default(now())
  user       Users    @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@map("dia_chi_luu")
}

model TheoDoiNguoiBan {
  id         Int      @id @default(autoincrement())
  buyer_id   Int
  seller_id  Int
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  buyer      Users    @relation("buyerSubscriptions", fields: [buyer_id], references: [user_id], onDelete: Cascade)
  seller     Users    @relation("sellerSubscribers", fields: [seller_id], references: [user_id], onDelete: Cascade)

  @@unique([buyer_id, seller_id])
  @@map("theo_doi_nguoi_ban")
}

